{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Auto Remix Workstation",
  "version": "0.1.0",
  "identifier": "com.local.ai-auto-remix",
  "build": {
    "beforeDevCommand": "cd frontend && npm.cmd run dev",
    "beforeBuildCommand": "cd frontend && npm.cmd run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Auto Remix Workstation",
        "width": 1440,
        "height": 970,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../backend": "backend"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
